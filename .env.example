PORTAINER_URL=https://portainer.lan:9443
PORTAINER_API_TOKEN=ptr_xxxxxxxxxxxxxxxxxxxx
PORTAINER_SKIP_TLS_VERIFY=false
REFRESH_INTERVAL_HOURS=6

# Login: first sign-in is admin / manifest (you are forced to choose a new password).
# Users and passwords are managed in the app (gear icon), not here.
# Set true when behind a reverse proxy (Nginx Proxy Manager, Cloudflare Tunnel...) so
# the app sees each visitor's real address. See README before exposing to the internet.
TRUST_PROXY=false
# Optional global key for the read-only /api/stats endpoint (dashboard widgets such as Homepage).
# Normally leave empty and create per-user keys in the app instead (gear icon -> API keys).
# Generate one with: openssl rand -hex 24
STATS_API_KEY=
# Public exposure: consider turning the Update button off
ENABLE_UPDATES=true
# Optional: Discord alerts when a container newly has an update
DISCORD_WEBHOOK_URL=
# Optional: link shown in alerts, e.g. http://10.0.0.49:8080
PUBLIC_URL=
